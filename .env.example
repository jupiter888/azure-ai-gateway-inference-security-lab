# Project 9 — Configuration template
# Replaced identity and hostname placeholders in a private .env file.
# Never placed real credentials in this example.

P9_TENANT_ID=replace-with-tenant-id
P9_TEST_CLIENT_ID=replace-with-test-client-id
P9_GATEWAY_CLIENT_ID=replace-with-gateway-client-id

P9_JWT_ISSUER=https://sts.windows.net/replace-with-tenant-id/
P9_JWT_AUDIENCE=api://replace-with-gateway-client-id
P9_JWKS_URL=https://login.microsoftonline.com/replace-with-tenant-id/discovery/keys

P9_ALLOWED_CLIENT_ID=replace-with-test-client-id
P9_REQUIRED_TOKEN_VERSION=1.0

P9_AZURE_GATEWAY_URL=https://replace-with-public-gateway-hostname

# Default forwarding mode fails closed without backend configuration.
# The in-process validator selects synthetic mode within its own process.
P9_INFERENCE_MODE=backend

# Configure only when running a local gateway/backend integration.
# Deployed applications receive these settings through Azure configuration.
P9_BACKEND_URL=
P9_BACKEND_SERVICE_KEY=

P9_BACKEND_CONNECT_TIMEOUT_SECONDS=10
P9_BACKEND_READ_TIMEOUT_SECONDS=60
P9_BACKEND_WRITE_TIMEOUT_SECONDS=10
P9_BACKEND_POOL_TIMEOUT_SECONDS=5

# The encrypted client key and public certificate belong outside the project.
# Certificate passphrases are entered interactively, never configured here.